generator client {
  provider = "prisma-client"
  output   = "../generated/"
}

datasource db {
  provider = "postgresql"
}

enum AccountRole {
  USER
  MODERATOR
  ADMIN
}

enum ProfileStatus {
  CREATED
  PENDING
  REJECTED
  VERIFIED
}

enum SizeUnit {
  CM
  INCH
}

model Account {
  id       String @id @default(cuid(2))
  username String @unique
  email    String @unique
  password String
  salt     String

  role AccountRole @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions             Session[]
  profiles             Profile[]
  passwordResetTokens  PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(cuid(2))
  tokenHash String   @unique
  accountId String
  expiresAt DateTime

  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model Session {
  sessionId String  @id
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model Profile {
  id        String @id @default(cuid(2))
  accountId String

  displayName String
  avatarUrl   String?
  bannerUrl   String?

  birthday  DateTime?
  size      Float
  unit      SizeUnit
  pronouns  String?
  location  String?
  interests String[]
  bio       String?

  status ProfileStatus @default(CREATED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}
