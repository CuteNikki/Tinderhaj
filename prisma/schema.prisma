generator client {
  provider = "prisma-client"
  output   = "../generated/"
}

datasource db {
  provider = "postgresql"
}

enum AccountRole {
  USER
  MODERATOR
  ADMIN
}

enum ProfileStatus {
  CREATED
  PENDING
  REJECTED
  VERIFIED
}

enum SizeUnit {
  CM
  INCH
}

/// Why someone reported a shark. Labels in lib/reports.ts.
enum ReportReason {
  NOT_A_SHARK
  INAPPROPRIATE
  PERSONAL_INFO
  HARASSMENT
  SPAM
  OTHER
}

enum ReportStatus {
  OPEN
  /// A moderator dealt with it, e.g. rejected the profile or banned its owner.
  RESOLVED
  /// A moderator found nothing wrong.
  DISMISSED
}

/// Someone with a Tinderhaj account. Better Auth calls this the user and
/// knows `username` as its `name`.
model User {
  id               String   @id @default(cuid(2))
  username         String   @unique
  email            String   @unique
  emailVerified    Boolean  @default(false)
  image            String?
  /// Whether signing in with a password asks for a second step.
  twoFactorEnabled Boolean? @default(false)

  role AccountRole @default(USER)

  /// How the owners of sharks that match one of theirs can reach them, e.g.
  /// "Discord: nikki". Only shown on matches.
  matchContact String?

  /// Banned accounts can't sign in. Check banExpires too (see lib/bans.ts):
  /// an expired ban is only cleared at their next sign-in.
  banned      Boolean   @default(false)
  /// Shown to them when they try to sign in.
  banReason   String?
  /// When the ban ends by itself. Null bans until it's lifted.
  banExpires  DateTime?
  bannedAt    DateTime?
  bannedById  String?
  bannedBy    User?     @relation("BannedBy", fields: [bannedById], references: [id], onDelete: SetNull)
  /// Accounts this moderator or admin banned.
  usersBanned User[]    @relation("BannedBy")

  reportsMade    Report[] @relation("ReportsMade")
  reportsHandled Report[] @relation("ReportsHandled")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions   Session[]
  accounts   Account[]
  twoFactors TwoFactor[]
  passkeys   Passkey[]
  profiles   Profile[]
}

/// A way to sign in. Only `credential`, which holds the password as
/// `salt:hash`, since Tinderhaj has no other providers.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Links sent by email (verifying, changing email, resetting the password,
/// deleting the account), and devices that skip two-step sign-in.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// An authenticator app set up for two-step sign-in, with backup codes.
/// Accounts using email codes only have none.
model TwoFactor {
  id                      String    @id
  /// Encrypted by Better Auth, like the backup codes.
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// False until the first code from the app confirms it's set up.
  verified                Boolean?  @default(true)
  /// For locking sign-in after too many wrong codes.
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
}

/// A passkey someone can sign in with instead of a password.
model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  /// Which kind of authenticator made it, when it says.
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
}

model Profile {
  id     String @id @default(cuid(2))
  userId String

  displayName String
  avatarUrl   String?
  bannerUrl   String?

  birthday  DateTime?
  size      Float?
  unit      SizeUnit
  pronouns  String?
  location  String?
  interests String[]
  bio       String?

  status ProfileStatus @default(CREATED)

  rejectedFields String[] @default([])
  rejectionNote  String?

  submittedAt DateTime?
  verifiedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  heartsSent     Heart[]  @relation("HeartsSent")
  heartsReceived Heart[]  @relation("HeartsReceived")
  reports        Report[]

  @@index([userId])
}

/// One shark telling another it likes them. Two sharks hearting each other
/// is a match.
model Heart {
  id            String @id @default(cuid(2))
  fromProfileId String
  toProfileId   String

  createdAt DateTime  @default(now())
  /// When the owner of the shark it went to saw it, for the nav's dot.
  seenAt    DateTime?

  from Profile @relation("HeartsSent", fields: [fromProfileId], references: [id], onDelete: Cascade)
  to   Profile @relation("HeartsReceived", fields: [toProfileId], references: [id], onDelete: Cascade)

  @@unique([fromProfileId, toProfileId])
  @@index([toProfileId])
}

/// A signed-in user telling moderators a shark breaks the rules, or the way
/// to reach its owner does, for a match.
model Report {
  id        String  @id @default(cuid(2))
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// Kept when they delete their account, without saying who it was.
  reporterId String?
  reporter   User?   @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: SetNull)

  reason      ReportReason
  details     String?
  /// The owner's way to be reached as it was when a match reported it, so
  /// changing it afterwards doesn't hide what was reported. Null when the
  /// report is about the shark itself.
  contactNote String?

  status      ReportStatus @default(OPEN)
  handledAt   DateTime?
  handledById String?
  handledBy   User?        @relation("ReportsHandled", fields: [handledById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
}
