{
  "name": "tinderhaj-bot",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun --env-file=../.env run src/index.ts --debug",
    "start": "bun run src/index.ts",
    "register": "bun --env-file=../.env run src/utility/register.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "bun --bun run prisma generate --schema ../prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "discord.js": "14.27.0",
    "globby": "16.2.4",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "prisma": "^7.10.1",
    "typescript": "6.0.3"
  }
}
