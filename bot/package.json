{
  "name": "tinderhaj-bot",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun --env-file=../.env run src/index.ts --debug",
    "start": "bun run src/index.ts",
    "register": "bun --env-file=../.env run src/utility/register.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "bun --bun run prisma generate --schema ../prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "discord.js": "14.27.0",
    "globby": "14.1.0",
    "pino": "9.14.0",
    "pino-pretty": "13.1.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "prisma": "7.10.0",
    "typescript": "5.9.3"
  }
}
