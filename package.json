    "better-auth": "1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.8",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
